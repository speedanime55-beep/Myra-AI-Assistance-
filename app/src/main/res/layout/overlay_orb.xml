<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="160dp"
    android:layout_height="160dp"
    android:background="@drawable/bg_overlay_orb"
    android:padding="8dp">

    <com.example.ui.main.OrbAnimationView
        android:id="@+id/overlayOrbView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/overlayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.22"
        android:text="@string/myra_title"
        android:textColor="@color/myra_text_primary"
        android:textSize="11sp" />

    <ImageButton
        android:id="@+id/overlayCloseBtn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_overlay_orb"
        android:contentDescription="@string/cd_close_overlay"
        android:padding="8dp"
        android:src="@drawable/ic_close" />
</FrameLayout>
