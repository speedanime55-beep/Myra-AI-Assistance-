<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/dialogNameInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/hint_contact_name"
        android:inputType="textPersonName"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/myra_text_primary"
        android:textColorHint="@color/myra_text_hint"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/dialogNumberInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/hint_contact_number"
        android:inputType="phone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/myra_text_primary"
        android:textColorHint="@color/myra_text_hint"
        android:textSize="14sp" />
</LinearLayout>
