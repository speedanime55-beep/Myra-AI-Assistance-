<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_mesh">

    <!-- Main HUD + Orb + Chat + Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- TOP HUD BAR -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- LEFT: Battery & RAM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/cd_battery"
                        android:src="@drawable/ic_battery" />

                    <TextView
                        android:id="@+id/batteryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="monospace"
                        android:text="100%"
                        android:textColor="@color/myra_red_soft"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ramText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="RAM --"
                    android:textColor="@color/myra_text_secondary"
                    android:textSize="10sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- CENTER: MYRA Identity -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.3"
                    android:text="@string/myra_title"
                    android:textColor="@color/myra_red"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.18"
                    android:text="@string/myra_subtitle"
                    android:textColor="@color/myra_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- RIGHT: Time & Settings -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="monospace"
                    android:text="00:00"
                    android:textColor="@color/myra_red_soft"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/settingsBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_settings"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- CENTER: Animated Orb + Waveform + Status -->
        <LinearLayout
            android:id="@+id/orbSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/chatRecycler"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintVertical_chainStyle="packed">

            <com.example.ui.main.OrbAnimationView
                android:id="@+id/orbView"
                android:layout_width="250dp"
                android:layout_height="250dp" />

            <com.example.ui.main.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="200dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/status_idle"
                android:textColor="@color/myra_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- BOTTOM: Chat Transcript RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecycler"
            android:layout_width="0dp"
            android:layout_height="176dp"
            android:layout_marginBottom="8dp"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:requiresFadingEdge="vertical"
            app:layout_constraintBottom_toTopOf="@id/quickInputRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Quick Text Command / Message Row -->
        <LinearLayout
            android:id="@+id/quickInputRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            app:layout_constraintBottom_toTopOf="@id/micContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_type_message"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="@color/myra_text_primary"
                android:textColorHint="@color/myra_text_hint"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/sendBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_send_button"
                android:padding="10dp"
                android:src="@drawable/ic_send" />
        </LinearLayout>

        <!-- Mic Button + Hint -->
        <LinearLayout
            android:id="@+id/micContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_mic_button"
                android:contentDescription="@string/cd_mic_button"
                android:elevation="8dp"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic_off" />

            <TextView
                android:id="@+id/micHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="@string/hint_long_press_stop"
                android:textColor="@color/myra_text_hint"
                android:textSize="10sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FULL-SCREEN RED OVERLAY EFFECT (alpha 0 -> 0.08 when active) -->
    <View
        android:id="@+id/redOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/myra_red"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
