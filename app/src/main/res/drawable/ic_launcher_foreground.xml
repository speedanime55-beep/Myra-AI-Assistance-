<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer orbital halo -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,23 A31,31 0 1,1 23,54"
        android:strokeWidth="3.2"
        android:strokeColor="#FFD500F9"
        android:strokeLineCap="round" />

    <path
        android:fillColor="#00000000"
        android:pathData="M54,85 A31,31 0 0,1 23,54"
        android:strokeWidth="2.2"
        android:strokeColor="#88FF1744"
        android:strokeLineCap="round" />

    <!-- Core glowing MYRA orb -->
    <path android:pathData="M54,30 A24,24 0 1,0 54,78 A24,24 0 1,0 54,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="46"
                android:centerY="44"
                android:gradientRadius="28"
                android:type="radial">
                <item
                    android:color="#FFFF5277"
                    android:offset="0.0" />
                <item
                    android:color="#FFFF1744"
                    android:offset="0.55" />
                <item
                    android:color="#FFD500F9"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized voice equalizer bars inside orb -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M42,48 L45,48 L45,60 L42,60 Z M48,43 L51,43 L51,65 L48,65 Z M54,39 L57,39 L57,69 L54,69 Z M60,44 L63,44 L63,64 L60,64 Z M66,49 L69,49 L69,59 L66,59 Z" />

    <!-- Accent orbital spark -->
